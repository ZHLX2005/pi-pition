{
  "name": "@flowot/pi-pition",
  "version": "0.7.0",
  "description": "Notion 个人记录助手 — 把 Notion 数据库变成 pi agent 的持久化存储（page列表透明、属性追加合并、区间事件记录、5阶段引导配置）。",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "notion",
    "personal-knowledge-management",
    "notes",
    "journal"
  ],
  "license": "MIT",
  "author": "pition contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZHLX2005/pi-pition.git"
  },
  "bugs": {
    "url": "https://github.com/ZHLX2005/pi-pition/issues"
  },
  "files": [
    "src/",
    "docs/",
    "extensions/",
    "skills/",
    "index.ts",
    "pition.config.example.json",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LINT-EXEMPTIONS.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "typebox": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "jiti": "2.7.0",
    "knip": "^6.38.0",
    "typebox": "1.3.27",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/ extensions/ scripts/ index.ts",
    "lint:fix": "biome check --write --unsafe src/ test/ extensions/ scripts/ index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip --no-progress",
    "context:generate": "node scripts/check-context-budget.mjs",
    "context:check": "node scripts/check-context-budget.mjs --check",
    "smoke": "node scripts/smoke-load.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run context:check && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./extensions/pition.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "lintExemptions": "./LINT-EXEMPTIONS.md"
}
